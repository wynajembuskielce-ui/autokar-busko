import type { Metadata } from "next";
import { Noto_Sans, Noto_Sans_Arabic } from "next/font/google";
import Script from "next/script";
import { StickyCallButton } from "@/components/StickyCallButton";
import "./globals.css";

const notoSans = Noto_Sans({
  variable: "--font-main",
  subsets: ["latin", "latin-ext", "cyrillic"],
  display: "swap",
});

const notoSansArabic = Noto_Sans_Arabic({
  variable: "--font-arabic",
  subsets: ["arabic"],
  display: "swap",
});

export const metadata: Metadata = {
  title: "Wynajem Autokaru Kielce | Busy i Autokary na Wynajem – +48 601 076 652 lub +48 41 345 32 25",
  description:
    "Profesjonalny wynajem autokaru w Kielcach. Busy, autokary i minibusy na wesela, wycieczki, pielgrzymki i transfery lotniskowe. Zadzwoń: +48 601 076 652 lub +48 41 345 32 25",
};

export default function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  const gaId = process.env.NEXT_PUBLIC_GA_ID;

  return (
    <html lang="pl" className={`${notoSans.variable} ${notoSansArabic.variable} h-full antialiased`}>
      <head>
        {gaId ? (
          <>
            <Script strategy="afterInteractive" src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
            <Script id="ga-init" strategy="afterInteractive">
              {`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${gaId}');`}
            </Script>
          </>
        ) : null}
      </head>
      <body className="min-h-full bg-white text-[#1a1a1a]">
        {children}
        <StickyCallButton />
      </body>
    </html>
  );
}

